<!-- res/values/themes.xml -->
<resources>
    <style name="Theme.Sms" parent="Theme.Material3.Light.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/colorPrimaryBrand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/colorDialogBg</item>
        <item name="colorOnSurface">@color/black</item>
        
        <!-- Dialog Styling -->
        <item name="materialAlertDialogTheme">@style/CustomAlertDialog</item>

        <!-- Popup Menu Styling -->
        <item name="android:popupMenuStyle">@style/Widget.AppCompat.PopupMenu</item>
        <item name="android:listPopupWindowStyle">@style/CustomListPopupWindow</item>
        <item name="android:listDivider">@null</item>
        <item name="android:dropDownHorizontalOffset">-16dp</item>

        <!-- Disable Android's automatic "force dark" -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="CustomListPopupWindow" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@drawable/menu_background</item>
        <item name="android:dropDownHorizontalOffset">-16dp</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Dialog background fixed to #F2F2F2 -->
        <item name="android:background">@color/colorDialogBg</item>
        <item name="colorSurface">@color/colorDialogBg</item>
        <item name="colorSurfaceVariant">@color/colorDialogBg</item>
        
        <!-- Removing elevation is the only way to stop the green tint in some M3 versions -->
        <item name="elevation">0dp</item>
        
        <!-- Button and Text color -->
        <item name="colorPrimary">@color/colorPrimaryBrand</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/grey_text</item>
        <item name="colorOnSurface">@color/black</item>
    </style>
</resources>
